# Copy to `.env.local` (never commit real values).
# Only EXPO_PUBLIC_* vars are available in the app bundle — never put secrets there.

EXPO_PUBLIC_APP_NAME=App Template

# RevenueCat public SDK keys (client-safe; still never commit real project keys).
# Required only when MONETIZATION !== free AND PURCHASES_MODE=live.
# EXPO_PUBLIC_REVENUECAT_API_KEY=REPLACE_WITH_REVENUECAT_PUBLIC_SDK_KEY
# Or platform-specific:
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=REPLACE_WITH_REVENUECAT_IOS_PUBLIC_SDK_KEY
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=REPLACE_WITH_REVENUECAT_ANDROID_PUBLIC_SDK_KEY

# Optional — leave commented until you activate Sentry (see docs/recipes/error-reporting.md).
# EXPO_PUBLIC_SENTRY_DSN=
