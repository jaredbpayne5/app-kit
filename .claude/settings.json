{
  "permissions": {
    "deny": [
      "Edit(./.claude/hooks/**)",
      "Edit(./.claude/settings.json)",
      "Edit(./.cursor/hooks/**)",
      "Edit(./.cursor/hooks.json)",
      "Edit(./.githooks/**)",
      "Edit(./eslint.config.js)",
      "Edit(./.github/workflows/ci.yml)",
      "Edit(./scripts/lib/guard-*.sh)",
      "Edit(./scripts/lib/fail-proof-checks.test.sh)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/lib/guard-sensitive-writes-claude.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-secrets.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/lib/guard-deploy-claude.sh"
          }
        ]
      }
    ]
  }
}
