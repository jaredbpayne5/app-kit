{
  "permissions": {
    "deny": [
      "Edit(./.claude/hooks/**)",
      "Edit(./.githooks/**)",
      "Edit(./eslint.config.js)",
      "Edit(./.github/workflows/ci.yml)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-sensitive-writes.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-secrets.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-deploy.sh"
          }
        ]
      }
    ]
  }
}
