{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./apps/mobile/*"]
    }
  },
  "include": [
    "apps/mobile/**/*.ts",
    "apps/mobile/**/*.tsx",
    "apps/mobile/.expo/types/**/*.ts",
    "apps/mobile/expo-env.d.ts",
    "apps/mobile/nativewind-env.d.ts"
  ],
  "exclude": ["node_modules", "apps/mobile/android", "apps/mobile/ios", "apps/mobile/node_modules"]
}
