# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
apps/web/dist/

# Cloudflare Wrangler local scratch (created by web:deploy / wrangler CLI)
.wrangler/

# Native (CNG — generated by Expo/EAS; do not commit).
