/android/
/ios/
apps/mobile/android/
apps/mobile/ios/

# Native secrets / signing
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*service-account*.json
google-services.json
GoogleService-Info.plist
credentials.json

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# env
.env
.env.*
!.env.example
apps/mobile/.env
apps/mobile/.env.*
!apps/mobile/.env.example

# typescript
*.tsbuildinfo

# @generated expo-cli
expo-env.d.ts
apps/mobile/expo-env.d.ts

# Maestro local debug dumps (temp flows + failure artifacts)
.maestro-debug/
commands-(maestro-*.json
screenshot-*-*(maestro-*.png
xctest_runner_*.log
maestro.log

# XcodeBuildMCP local scratch
.xcodebuildmcp/

# Store screenshot pipeline outputs (regenerate via npm run screenshots)
apps/mobile/store/screenshots/raw/**
