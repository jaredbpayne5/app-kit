{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  // Template inventory — see docs/CAPABILITIES.md "Starter kit vs shipped code".
  // Keep these ignores on knip:clone so a product clone does not delete the factory.
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.ts"],
    },
  },
  "ignore": [
    "apps/mobile/metro.config.js",
    "apps/mobile/lib/streak.ts",
    "apps/mobile/lib/review-prompt.ts",
    "apps/mobile/lib/local-notifications.ts",
    "apps/mobile/lib/secure-storage.ts",
    "apps/mobile/lib/purchases.ts",
    "apps/mobile/lib/paywall-plans.ts",
    "apps/mobile/lib/paywall-plans.storekit.test.ts",
    "apps/mobile/components/paywall.tsx",
    "apps/mobile/components/date-field.tsx",
    "apps/mobile/components/number-wheel-field.tsx",
    "apps/mobile/components/header-overflow-menu.tsx",
    "apps/mobile/ui/card.tsx",
    "apps/mobile/ui/chart.tsx",
    "apps/mobile/ui/input.tsx",
    "apps/mobile/ui/label.tsx",
    "apps/mobile/ui/separator.tsx",
    "apps/mobile/ui/switch.tsx",
    "apps/mobile/ui/textarea.tsx",
    "apps/mobile/ui/alert-dialog.tsx",
    "apps/mobile/ui/native-only-animated-view.tsx",
    "apps/mobile/app/(tabs)/index.tsx",
    "apps/mobile/app/(tabs)/library.tsx",
    "apps/mobile/app/onboarding.tsx",
  ],
  "ignoreDependencies": [
    "expo-notifications",
    "expo-secure-store",
    "react-native-purchases",
    "@sentry/react-native",
    "@shopify/flash-list",
    "@gorhom/bottom-sheet",
    "@react-native-community/datetimepicker",
    "@react-native-picker/picker",
    "@rn-primitives/alert-dialog",
    "@rn-primitives/label",
    "@rn-primitives/separator",
    "@rn-primitives/switch",
    "expo-blur",
    "expo-clipboard",
    "expo-linear-gradient",
    "expo-localization",
    "expo-sharing",
    "expo-store-review",
    "expo-symbols",
    "expo-updates",
    "lucide-react-native",
    "@types/react",
    "@react-native/normalize-colors",
  ],
}
